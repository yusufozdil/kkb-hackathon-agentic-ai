# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun:
# cp .env.example .env

# ----------------------------------------
# TOBB (Ticaret Sicil Gazetesi) Credentials
# ----------------------------------------
# Ticaret Sicil sistemi için email ve şifre
TTS_EMAIL="Ng8224@gmail.com"
TTS_PASSWORD="E9HMFDawP8$tuc"

# ----------------------------------------
# TOBB Session Cookies (CAPTCHA Bypass)
# ----------------------------------------
# Tarayıcınızdan cookie'leri alıp buraya yapıştırın:
# 1. Chrome/Firefox'ta www.ticaretsicil.gov.tr'ye gidin
# 2. Developer Tools (F12) > Application > Cookies
# 3. atrsrv-101020155 ve atrsrv-101041124 cookie değerlerini kopyalayın
# 4. Aşağıya yapıştırın

TOBB_COOKIE_0=your_atrsrv_101020155_cookie_here
TOBB_COOKIE_1=your_atrsrv_101041123_cookie_here
TOBB_COOKIE_2=your_atrsrv_101041124_cookie_here

# ----------------------------------------
# NOTLAR
# ----------------------------------------
# - Cookie'ler periyodik olarak expire olur, yenilemeniz gerekebilir
# - TTS_EMAIL ve TTS_PASSWORD cookie'ler çalışırsa gerekli olmayabilir


# API Key
KKB_API_KEY=sk-your-api-key-here

# API Base URL (Değiştirmeyin)
KKB_BASE_URL=https://mia.csp.kloudeks.com/v1

# Ana LLM Modeli (120B parametreli, güçlü model)
KKB_MODEL=gpt-oss-120b

# Embedding Modeli (Vektör embeddings için)
KKB_EMBEDDING_MODEL=qwen3-embedding-8b